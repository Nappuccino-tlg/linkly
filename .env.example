# Copy to .env and adjust. Never commit the real .env
# Set ENVIRONMENT=production to enforce a strong JWT_SECRET at startup.
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://linkly:linkly@localhost:5432/linkly
REDIS_URL=redis://localhost:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-before-deploying
ACCESS_TOKEN_TTL_MINUTES=1440

# Public origin used to build short links
BASE_URL=http://localhost:8000

CREATE_LIMIT_PER_HOUR=30
REDIRECT_CACHE_TTL_SECONDS=3600
