{
  "name": "Linkly",
  "dockerComposeFile": "compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/linkly",

  // Applied by Codespaces, not by a plain `docker compose up` -- so gh is present in a
  // Codespace and absent when the same compose file is run by hand.
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  "onCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/serve.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Linkly",
      "onAutoForward": "openPreview",
      // Public, because the point of the button on the README is that a stranger can try
      // it. A private forwarded port sends the browser through a sign-in postback first,
      // and when that does not complete the page simply fails. The Codespace is the
      // visitor's own throwaway instance, so there is nothing here to protect.
      "visibility": "public"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true
        }
      }
    }
  }
}
